MONGODB_URI=mongodb://127.0.0.1:27017/prodid
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# شماره‌های مالک پنل (با ویرگول جدا کنید). در اولین ورود، نقش owner می‌گیرند.
ADMIN_PHONES=09130612019

# زرین‌پال — https://www.zarinpal.com/docs/paymentGateway/connectToGateway.html
# در سندباکس می‌توانید یک UUID دلخواه بگذارید: https://www.zarinpal.com/docs/paymentGateway/sandBox.html
ZARINPAL_MERCHANT_ID=
# 1 = سرویس تست بدون پرداخت واقعی
ZARINPAL_SANDBOX=1
# IRT تومان (مطابق قیمت فروشگاه) یا IRR ریال
ZARINPAL_CURRENCY=IRT

