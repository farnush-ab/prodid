# نمونهٔ تنظیمات پرودید — این فایل در گیت است، پس هیچ مقدار واقعی‌ای
# نباید این‌جا نوشته شود؛ فقط نام متغیرها.
# برای اجرا: این فایل را به .env.local (توسعه) یا .env (سرور) کپی کنید
# و مقدارها را آن‌جا بگذارید. هر دو در .gitignore هستند.

MONGODB_URI=mongodb://127.0.0.1:27017/prodid
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# شماره‌های مالک پنل (با ویرگول جدا کنید). در اولین ورود، نقش owner می‌گیرند.
ADMIN_PHONES=

# زرین‌پال — https://www.zarinpal.com/docs/paymentGateway/connectToGateway.html
# در سندباکس می‌توانید یک UUID دلخواه بگذارید: https://www.zarinpal.com/docs/paymentGateway/sandBox.html
ZARINPAL_MERCHANT_ID=
# 1 = سرویس تست بدون پرداخت واقعی
ZARINPAL_SANDBOX=1
# IRT تومان (مطابق قیمت فروشگاه) یا IRR ریال
ZARINPAL_CURRENCY=IRT

# IPPanel — https://docs.ippanel.com/docs/send/
# ارسال پترن: POST https://edge.ippanel.com/v1/api/send  sending_type=pattern
# ⚠️ این مقدار را این‌جا پر نکنید. کلید واقعی فقط در فایل .env روی سرور
# (یا .env.local در توسعه) می‌نشیند که هیچ‌کدام کامیت نمی‌شوند.
IPPANEL_API_KEY=
IPPANEL_FROM=
# اختیاری؛ پیش‌فرض همان آدرس رسمی
# IPPANEL_BASE_URL=https://edge.ippanel.com/v1/api
IPPANEL_PATTERN_OTP=
IPPANEL_PATTERN_ORDER_PENDING=
IPPANEL_PATTERN_ORDER_CONFIRMED=
IPPANEL_PATTERN_ORDER_PREPARING=
IPPANEL_PATTERN_ORDER_DELIVERING=
IPPANEL_PATTERN_ORDER_DELIVERED=
IPPANEL_PATTERN_ORDER_CANCELLED=
IPPANEL_PATTERN_PAY_PAID=
IPPANEL_PATTERN_PAY_FAILED=
IPPANEL_PATTERN_COUPON_PUBLIC=
IPPANEL_PATTERN_COUPON_LOYALTY=
IPPANEL_PATTERN_BIRTHDAY=
IPPANEL_PATTERN_RESTOCK=
